SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
# Base64-encoded 32-byte secret used to encrypt user model keys at rest.
SETTINGS_ENCRYPTION_KEY=generate-a-unique-32-byte-base64-secret
# Optional fallback only. Once you save a DeepSeek key in Settings, remove this.
DEEPSEEK_API_KEY=replace-with-deepseek-key
# OPENAI_API_KEY=replace-if-you-enable-gpt-models
# ANTHROPIC_API_KEY=replace-if-you-enable-claude-models
# FRONTEND_ORIGIN=https://your-vercel-app.vercel.app,http://localhost:5173
